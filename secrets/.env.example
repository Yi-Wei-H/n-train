# ntrain 凭证模板 —— 复制为 .env 后填入真实值（openssl rand -base64 24 生成）

# MySQL
MYSQL_ROOT_PASSWORD=

# PostgreSQL（pgvector，train-agent 向量存储）
PG_PASSWORD=
POSTGRES_PASSWORD="${PG_PASSWORD}"

# Redis
REDIS_PASSWORD=

# Sentinel Dashboard 控制台密码（账号固定 sentinel）
SENTINEL_PASSWORD=

# Grafana admin 密码（仅 --profile monitor 启动时用）
GRAFANA_PASSWORD=

# Nacos（已开鉴权；NACOS_PASSWORD 即服务端账号密码，部署时会同步到控制台 nacos 用户）
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_CONSOLE_PASSWORD=

# JWT 签名密钥（≥32 字节）
JWT_SECRET=

# 敏感字段 AES 密钥（必须 16 个字符；前端 .env 的 VITE_AES_KEY 用同一个值；无任何默认值）
NTRAIN_AES_KEY=

# 各端重置/初始默认密码（无默认值；本组变量为启动必需项，缺任意一个 admin/member 服务起不来）
SUPER_ADMIN_PASSWORD=
ADMIN_DEFAULT_PASSWORD=
MEMBER_DEFAULT_PASSWORD=
