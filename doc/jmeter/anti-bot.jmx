                <stringProp name="Header.name">X-Forwarded-For</stringProp>
                <stringProp name="Header.value">${__groovy(&apos;10.&apos;+(1+(int)(Math.random()*250))+&apos;.&apos;+(1+(int)(Math.random()*250))+&apos;.&apos;+(1+(int)(Math.random()*250)))}</stringProp>
              </elementProp>
