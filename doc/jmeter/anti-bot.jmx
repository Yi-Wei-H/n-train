          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-1~3次41009,4~5次41005" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def it = vars.getIteration()
def expect = (it &lt;= 3) ? 41009 : 41005
if (r.code != expect) {
  def hint = ""
  if (r.code == 42900) { hint = "60s 滑窗内有其他下单污染了限流桶，等 60s 重跑" }
  else if (r.code == 40100) { hint = "账号A token 失效，重新从浏览器取" }
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage("第" + it + "次预期 " + expect + "(60s内第4单起强制验证码)，实际 " + r.code + " " + r.message + " " + hint)
}</stringProp>
