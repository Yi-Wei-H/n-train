          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-43008令牌大闸拦截" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (r.code != 43008) {
  def hint = ""
  if (r.code == 0) { hint = "真实成单! 令牌未置零或已懒重建，先执行 anti-bot.md 里的 Redis SET 0 再重跑，并取消该订单" }
  else if (r.code == 41005) { hint = "账号B 被验证码标记(10分钟TTL)，换账号或手动清 ntrain:order:captcha:required:*" }
  else if (r.code == 42900) { hint = "限流桶未清(60s滑窗)，稍后重跑" }
  else if (r.code == 41009) { hint = "passengerId 不属于账号B，检查 CSV 第2行" }
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage("令牌大闸未拦截：code=" + r.code + " " + r.message + "。提示：" + hint)
}</stringProp>
