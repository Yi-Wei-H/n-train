          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-第5单起41005,第11单起42900(USER文案)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def it = vars.getIteration()
if (it &gt;= 11) {
  if (r.code != 42900 || r.message != &quot;下单太频繁啦，休息一下&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;第&quot; + it + &quot;次应触发 USER 维度限流(42900/下单太频繁啦，休息一下)，实际 code=&quot; + r.code + &quot; message=&quot; + r.message)
  }
} else {
  def expect = (it &lt;= 4) ? 41009 : 41005
  if (r.code != expect) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;第&quot; + it + &quot;次预期 &quot; + expect + &quot;(假乘车人被拦/验证码标记后缺码)，实际 &quot; + r.code + &quot; &quot; + r.message)
  }
}</stringProp>
          </JSR223Assertion>
