          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-第4单起41005,第11单起42900(USER文案)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def it = vars.getIteration()
if (it >= 11) {
  if (r.code != 42900 || r.message != "下单太频繁啦，休息一下") {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("第" + it + "次应触发 USER 维度限流(42900/下单太频繁啦，休息一下)，实际 code=" + r.code + " message=" + r.message)
  }
} else {
  def expect = (it &lt;= 3) ? 41009 : 41005
  if (r.code != expect) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("第" + it + "次预期 " + expect + "(假乘车人被拦/验证码标记后缺码)，实际 " + r.code + " " + r.message)
  }
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S2b-第二层限流-IP维度(多账号同IP)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">12</stringProp>
        </elementProp>
