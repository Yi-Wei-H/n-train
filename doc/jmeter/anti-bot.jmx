            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def n = Integer.parseInt(props.get("AB_USER_COUNT") ?: "1")
def idx = Math.min(ctx.getThreadNum() + 1, n)
vars.put("TK", props.get("AB_TOKEN_" + idx) ?: "no-token")
log.info("线程" + ctx.getThreadNum() + " 绑定账号#" + idx)</stringProp>
          </JSR223PreProcessor>
