            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def it = vars.getIteration()
def body = '{"rideDate":"' + vars.get("RIDE_DATE") + '","trainCode":"' + vars.get("TRAIN_CODE") + '","fromStation":"' + vars.get("FROM_ST") + '","toStation":"' + vars.get("TO_ST") + '","seatType":' + vars.get("SEAT_TYPE") + ',"passengerIds":[1]}'
if (it == 5) {
  body = body.substring(0, body.length() - 1) + ',"captchaKey":"not-exist-key","captchaCode":"ZZZZ"}'
}
sampler.getArguments().getArgument(0).setValue(body)</stringProp>
          </JSR223PreProcessor>
