          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-前10次41009,第11次起42900(IP文案)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def it = vars.getIteration()
def expect = (it &lt;= 10) ? 41009 : 42900
if (r.code != expect) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage("第" + it + "次预期 " + expect + "，实际 " + r.code + " " + r.message + "(IP桶唯一固定维度，第11次必来自IP限流)")
}
if (it >= 11 &amp;&amp; r.code == 42900 &amp;&amp; r.message != "下单太频繁啦，请稍后重试") {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage("IP/DEVICE 维度文案应为「请稍后重试」，实际 " + r.message + " —— 可能误触发 USER 维度")
}</stringProp>
          </JSR223Assertion>
