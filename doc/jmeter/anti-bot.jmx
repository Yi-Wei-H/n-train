        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S2a-固定userId连发12次" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.value">{"rideDate":"${RIDE_DATE}","trainCode":"${TRAIN_CODE}","fromStation":"${FROM_ST}","toStation":"${TO_ST}","seatType":${SEAT_TYPE},"passengerIds":[1]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
