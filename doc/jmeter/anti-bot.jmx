<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="防刷票四层防护验证">
      <stringProp name="TestPlan.comments">模拟机器刷票流量，逐层验证：L1 网关JWT(401/40100) - L2 三维度限流(42900) - L3 图形验证码(41005) - L4 令牌大闸(43008)。设计为零订单副作用。配套说明见 doc/jmeter/anti-bot.md</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="GPORT" elementType="Argument">
            <stringProp name="Argument.name">GPORT</stringProp>
            <stringProp name="Argument.value">${__P(gport,8000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MPORT" elementType="Argument">
            <stringProp name="Argument.name">MPORT</stringProp>
            <stringProp name="Argument.value">${__P(mport,8001)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RIDE_DATE" elementType="Argument">
            <stringProp name="Argument.name">RIDE_DATE</stringProp>
            <stringProp name="Argument.value">${__P(rideDate,2026-11-18)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TRAIN_CODE" elementType="Argument">
            <stringProp name="Argument.name">TRAIN_CODE</stringProp>
            <stringProp name="Argument.value">${__P(train,D901)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FROM_ST" elementType="Argument">
            <stringProp name="Argument.name">FROM_ST</stringProp>
            <stringProp name="Argument.value">${__P(from,AOP)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TO_ST" elementType="Argument">
            <stringProp name="Argument.name">TO_ST</stringProp>
            <stringProp name="Argument.value">${__P(to,CSQ)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEAT_TYPE" elementType="Argument">
            <stringProp name="Argument.name">SEAT_TYPE</stringProp>
            <stringProp name="Argument.value">${__P(seat,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FAKE_USER" elementType="Argument">
            <stringProp name="Argument.name">FAKE_USER</stringProp>
            <stringProp name="Argument.value">990001</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FAKE_IP" elementType="Argument">
            <stringProp name="Argument.name">FAKE_IP</stringProp>
            <stringProp name="Argument.value">10.99.1.7</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FAKE_DEVICE" elementType="Argument">
            <stringProp name="Argument.name">FAKE_DEVICE</stringProp>
            <stringProp name="Argument.value">perf-device-001</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="S0-准备-读账号与连通检查" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="S0-读取账号CSV到props" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def f = props.get(&quot;csv&quot;) ? new File(props.get(&quot;csv&quot;)) : null
if (f == null) {
  def base = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
  f = [new File(base, &quot;anti-bot-users.csv&quot;), new File(base, &quot;doc/jmeter/anti-bot-users.csv&quot;), new File(&quot;doc/jmeter/anti-bot-users.csv&quot;)].find { it.exists() }
}
if (f == null) {
  throw new RuntimeException(&quot;未找到 anti-bot-users.csv：请与 anti-bot.jmx 放同目录，或用 -Jcsv=绝对路径 指定（Windows 路径请用正斜杠 /）&quot;)
}
def rows = f.readLines().findAll { it.trim() &amp;&amp; !it.trim().startsWith(&quot;token,&quot;) }
if (rows.size() == 0) {
  throw new RuntimeException(&quot;anti-bot-users.csv 没有有效账号行&quot;)
}
rows.eachWithIndex { line, i -&gt;
  def p = line.split(&quot;,&quot;).collect { it.trim() }
  props.put(&quot;AB_TOKEN_&quot; + (i + 1), p[0])
  props.put(&quot;AB_PAX_&quot; + (i + 1), p.size() &gt; 1 ? p[1] : &quot;1&quot;)
  log.info(&quot;AB账号#&quot; + (i + 1) + &quot; token=&quot; + p[0].take(16) + &quot;... pax=&quot; + (p.size() &gt; 1 ? p[1] : &quot;-&quot;))
}
props.put(&quot;AB_USER_COUNT&quot;, String.valueOf(rows.size()))
if (rows.size() &lt; 2) {
  props.put(&quot;AB_TOKEN_2&quot;, props.get(&quot;AB_TOKEN_1&quot;))
  props.put(&quot;AB_PAX_2&quot;, props.get(&quot;AB_PAX_1&quot;))
  log.warn(&quot;CSV 只有 1 个账号：S4 将复用账号A，若返回 41005(验证码标记残留)属预期外，建议补第 2 行账号&quot;)
}
log.info(&quot;账号加载完成，共 &quot; + rows.size() + &quot; 个&quot;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S0-网关连通检查(白名单余票查询)" enabled="true">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${GPORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/member/ticket/query?rideDate=${RIDE_DATE}&amp;fromStation=${FROM_ST}&amp;toStation=${TO_ST}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-网关可达且返回code=0" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (r.code != 0) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;网关连通检查失败 code=&quot; + r.code + &quot; &quot; + r.message + &quot;，请确认 gateway(8000)/member 已启动，或用 -Jhost 指定正确地址&quot;)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S1-第一层JWT-无效凭证直接拒绝" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S1A1-裸请求无token">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${GPORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/member/order/create</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;rideDate&quot;:&quot;${RIDE_DATE}&quot;,&quot;trainCode&quot;:&quot;${TRAIN_CODE}&quot;,&quot;fromStation&quot;:&quot;${FROM_ST}&quot;,&quot;toStation&quot;:&quot;${TO_ST}&quot;,&quot;seatType&quot;:${SEAT_TYPE},&quot;passengerIds&quot;:[1]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="头-仅ContentType(模拟无token裸脚本)" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-401+40100" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def code = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).code
if (&quot;401&quot;.equals(prev.getResponseCode()) &amp;&amp; code == 40100) {
  prev.setSuccessful(true)
} else {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;预期 HTTP 401 + code=40100，实际 &quot; + prev.getResponseCode() + &quot; + &quot; + code + &quot; —— 第一层 JWT 未拦截&quot;)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S1A2-伪造乱码token">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${GPORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/member/order/create</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;rideDate&quot;:&quot;${RIDE_DATE}&quot;,&quot;trainCode&quot;:&quot;${TRAIN_CODE}&quot;,&quot;fromStation&quot;:&quot;${FROM_ST}&quot;,&quot;toStation&quot;:&quot;${TO_ST}&quot;,&quot;seatType&quot;:${SEAT_TYPE},&quot;passengerIds&quot;:[1]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="头-伪造Authorization" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.Zm9yZ2VkLXNpZ25hdHVyZS1ub3QtdmFsaWQ</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-401+40100" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def code = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).code
if (&quot;401&quot;.equals(prev.getResponseCode()) &amp;&amp; code == 40100) {
  prev.setSuccessful(true)
} else {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;预期 HTTP 401 + code=40100，实际 &quot; + prev.getResponseCode() + &quot; + &quot; + code + &quot; —— 第一层 JWT 未拦截&quot;)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S1A3-篡改payload不换签名">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${GPORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/member/order/create</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;rideDate&quot;:&quot;${RIDE_DATE}&quot;,&quot;trainCode&quot;:&quot;${TRAIN_CODE}&quot;,&quot;fromStation&quot;:&quot;${FROM_ST}&quot;,&quot;toStation&quot;:&quot;${TO_ST}&quot;,&quot;seatType&quot;:${SEAT_TYPE},&quot;passengerIds&quot;:[1]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="头-引用篡改后的token" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${TAMPERED_TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="前置-篡改真实token的sub声明(不换签名)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def t = props.get(&quot;AB_TOKEN_1&quot;)
def forged = &quot;eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiI5OTk5OTk5In0.Zm9yZ2VkLXNpZ25hdHVyZQ&quot;
if (t != null &amp;&amp; !t.contains(&quot;占位&quot;) &amp;&amp; t.split(&quot;\\.&quot;).length == 3) {
  def parts = t.split(&quot;\\.&quot;)
  def b64 = parts[1].replace(&apos;-&apos;, &apos;+&apos;).replace(&apos;_&apos;, &apos;/&apos;)
  while (b64.length() % 4 != 0) { b64 = b64 + &quot;=&quot; }
  def payload = new String(Base64.getDecoder().decode(b64), &quot;UTF-8&quot;)
  def tampered = payload.replaceFirst(&quot;\&quot;sub\&quot;:\&quot;[0-9]+\&quot;&quot;, &quot;\&quot;sub\&quot;:\&quot;999999999\&quot;&quot;)
  def nb = Base64.getUrlEncoder().withoutPadding().encodeToString(tampered.getBytes(&quot;UTF-8&quot;))
  forged = parts[0] + &quot;.&quot; + nb + &quot;.&quot; + parts[2]
  log.info(&quot;S1A3 已把 payload 的 sub 改成 999999999，签名保持原样 —— 验签必失败&quot;)
}
vars.put(&quot;TAMPERED_TOKEN&quot;, forged)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言-401+40100(防篡改)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def code = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).code
if (&quot;401&quot;.equals(prev.getResponseCode()) &amp;&amp; code == 40100) {
  prev.setSuccessful(true)
} else {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;预期 HTTP 401 + code=40100，实际 &quot; + prev.getResponseCode() + &quot; + &quot; + code + &quot; —— 篡改 payload 未被验签发现，JWT 防篡改失效&quot;)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S2a-第二层限流-USER维度(单账号高频)">
